---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Page not found', description: 'The requested Nexis wiki page could not be found.', template: 'splash', pagefind: false, head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }] }}>
  <div class="missing-page">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h2>That page isn't here.</h2>
    <p>Try the docs homepage, search, or the quick start.</p>
    <div class="actions">
      <a href="/">Docs home</a>
      <a href="/basics/quick-start/">Quick start</a>
    </div>
  </div>
</StarlightPage>

<style>
  .missing-page { max-width: 42rem; margin: 4rem auto; padding: 0 1rem; text-align: center; }
  .eyebrow { color: var(--sl-color-accent); font: 600 .8rem var(--sl-font-mono); letter-spacing: .12em; }
  h2 { margin: 1rem 0; font-size: clamp(2rem, 6vw, 3.5rem); }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .actions a { padding: .7rem 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; }
  .actions a:hover, .actions a:focus-visible { border-color: var(--sl-color-accent); }
</style>
